modbus:
  host: "127.0.0.1"
  port: 502
  timeout: 3
  addr: 0
  count: 4
  # modbus_retry_interval: 1.0 # 【预留，尚未实现】modbus重试间隔

mysql:
  host: "127.0.0.1"
  port: 3306
  user: "root"
  password: "fill_your_password"
  database: "modbus_db"
  charset: "utf8mb4"

redis:
  host: "127.0.0.1"
  port: 6379
  decode_responses: true
  # password: ""
  db: 0


# blacklist_ttl_sec: 300 #【预留，尚未实现；代码硬编码默认300秒，暂不从yaml读取】

# 从站设备配置 key: slave_id，value: 采集间隔(单位：秒)
slave_dict:
  1: 1
  2: 1

# ========= V2 保留原有基础配置 =========
txt_normal_path: "normal_record.txt"
txt_alarm_path: "alarm_record.txt"
txt_stat_path: "stat_record.txt"
cache_file: "offline_cache.json"
slave_online_cnt: 2
slave_offline_cnt: 3
stable_window_cnt: 3
stable_threshold: 0.5
alarm_interval: 300

# ========= V3 新增配置 =========
stat_interval: 5
heartbeat_interval: 10
data_queue_maxsize: 1000
consumer_thread_num: 2
max_thread_retry: 3
shutdown_max_wait: 10
batch_data_max: 200
mem_warn_threshold_mb: 300

